```python
#!/usr/bin/env python3
# -*- coding: utf-8 -*-
import os
import time
import torch
import torchaudio
from faster_whisper import WhisperModel
from liquid_audio import LFM2AudioModel, LFM2AudioProcessor, ChatState

# ── 🥊 글로벌 사격 통제 세팅 ──────────────────────────────────────────
HF_REPO     = "LiquidAI/LFM2.5-Audio-1.5B" 
TEST_DIR    = "/workspace/test_samples"
DEVICE      = "cuda"
# ───────────────────────────────────────────────────────────────────

print("=" * 60)
print("🕵️‍♂️ [최종 하이브리드] Faster-Whisper + Liquid 순정 시퀀셜 가동...")
print("=" * 60)

# 1. 귀(Whisper) 장착
print("🎤 1. Faster-Whisper (small) 로딩 중...")
whisper_model = WhisperModel("small", device=DEVICE, compute_type="float16")

# 2. 뇌(Liquid AI) 장착 - 순정 오디오 모델 클래스로 원복
print(f"🧠 2. Liquid AI 순정 오디오-텍스트 통합 엔진 로드 중... ({HF_REPO})")
processor = LFM2AudioProcessor.from_pretrained(HF_REPO)
model = LFM2AudioModel.from_pretrained(HF_REPO).to(DEVICE, dtype=torch.bfloat16).eval()

print("✅ 모든 엔진 순정 장전 완료! (에러 가드레일 완벽 통과)\n")

# 파일 필터링 및 정렬
raw_files = [f for f in os.listdir(TEST_DIR) if f.lower().endswith(".wav")]
def file_sort_key(f):
    name = os.path.splitext(f)[0]
    try: return (0, int(name.split('_')[0]))
    except: return (1, f)
wav_files = [os.path.join(TEST_DIR, f) for f in sorted(raw_files, key=file_sort_key)]

summary_records = []
print(f"🚀 총 {len(wav_files)}개 샘플 타격 개시!\n")

for idx, wav_path in enumerate(wav_files, 1):
    file_name = os.path.basename(wav_path)
    print(f"{'='*60}")
    print(f" 🎧 [{idx}/{len(wav_files)}] 파 일 명 : {file_name}")
    
    try:
        # --- [STAGE 1: Whisper 귀 작동] ---
        asr_start = time.time()
        segments, info = whisper_model.transcribe(wav_path, beam_size=3, language="ko")
        user_text = "".join([segment.text for segment in segments]).strip()
        asr_elapsed = time.time() - asr_start
        
        # --- [STAGE 2: Liquid AI 순정 뇌 작동] ---
        lm_start = time.time()
        
        # 고나우님이 사용하시던 순정 ChatState 구조 장전
        chat = ChatState(processor)
        chat.new_turn("system")
        # LLM에게 상담원 역할을 지시하는 시스템 프롬프트 주입
        chat.add_text("당신은 엘리베이터 고객센터 AI 상담원입니다. 사용자의 상황을 듣고 알맞은 조치를 한국어 한 문장으로 답변하세요.")
        chat.end_turn()
        
        chat.new_turn("user")
        # ★ 핵심: 오디오 인코더를 거치지 않고, 위스퍼가 정제한 완벽한 텍스트만 유저 인풋으로 주입!
        chat.add_text(user_text)
        chat.end_turn()
        
        chat.new_turn("assistant")

        text_out = []
        with torch.no_grad():
            # 기존에 완벽하게 동작하던 순정 시퀀셜 제너레이터 활용!
            for t in model.generate_sequential(**chat, max_new_tokens=64):
                if t.numel() == 1:
                    text_out.append(t)
        
        lm_elapsed = time.time() - lm_start
        total_elapsed = time.time() - asr_start

        # 텍스트 복원 부
        if text_out:
            token_ids = [t.item() if hasattr(t, 'item') else int(t) for t in text_out]
            ai_response = processor.text_tokenizer.decode(token_ids, skip_special_tokens=True).strip()
        else:
            ai_response = "❌ 답변 생성 실패"

        print(f" 📢 [ASR 인식] : {user_text}")
        print(f" 📢 [AI 조치]  : {ai_response}")
        print(f" ⏱️ 인식 시간 : {asr_elapsed:.2f}초 | 추론 시간 : {lm_elapsed:.2f}초")
        print(f" ⚡ 총 지연 시간 : {total_elapsed:.2f}초")

        summary_records.append({
            "idx": idx, "file": file_name, "asr": user_text, 
            "res": ai_response, "total": f"{total_elapsed:.2f}초"
        })

        # 메모리 청소
        del chat, text_out
        torch.cuda.empty_cache()

    except Exception as e:
        print(f" ❌ 에러 발생 : {e}")
        summary_records.append({
            "idx": idx, "file": file_name, "asr": "Error", 
            "res": str(e), "total": "Fail"
        })

# ── 🏆 최종 전황판 모아보기 ─────────────────────
print(f"\n\n{'='*30} 🏆 하이브리드 최종 전황판 {'='*30}\n")
print(f"{'번호':<4} | {'파일명':<15} | {'시간':<8} | {'인식 결과':<25} | {'AI 조치'}")
print("-" * 110)
for rec in summary_records:
    print(f"{rec['idx']:<4} | {rec['file']:<15} | {rec['total']:<8} | {rec['asr']:<25} | {rec['res']}")
print(f"\n{'='*95}\n")
```

